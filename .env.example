# LLM providers
OPENAI_API_KEY=
GOOGLE_API_KEY=
GEMINI_API_KEY=

# Optional tracing
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=db-curator
LANGSMITH_TRACING=false

# Literature APIs, optional but useful for higher throughput
SEMANTIC_SCHOLAR_API_KEY=
NCBI_API_KEY=
NCBI_EMAIL=

# Local runtime paths. Keep these outside the git repo when possible.
DB_CURATOR_CACHE_DIR=./local_runs/cache
DB_CURATOR_RESULTS_DIR=./local_runs/results
OFFLINE_PAPER_DB=
OFFLINE_FULLTEXT_DIR=
OFFLINE_FAISS_INDEX=

# Model/runtime defaults
DB_CURATOR_RESEARCHER_MODEL=gemini-2.5-flash
DB_CURATOR_CRITIQUE_MODEL=gpt-5-mini
OFFLINE_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
